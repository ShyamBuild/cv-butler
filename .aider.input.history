# 2026-11-10 11:25:05.984333
+cd ~/CV_Tool && cat > notes/fix_v489_feature.py << 'PYEOF'
+import sys, os
+sys.path.insert(0, os.path.join(os.getcwd(), 'archive'))
+import patchlib as P
+done = []
+M0 = P.perfile()
+B = P.read()
+s40 = next((k for k, l in enumerate(B) if l.strip().startswith("ck('S440 ")), None)
+if s40 is not None and not any(l.strip().startswith("ck('S441 ") for l in B):
+    d = P.ind(B[s40])
+    B.insert(s40+1, d*' ' + "ck('S441 the eye may name but never rename - authority rests with the trained gates and the master'+chr(39)+'s hand', (chr(35)+' EYES-PROPOSE-ONLY v85.98') in _src)")
+    B.insert(s40+2, d*' ' + "ck('S441B no background sweep renames from eye text', _src.count('os.rename(p, ' + '_q3)') == 0)")
+    B.insert(s40+3, d*' ' + "ck('S441C no service renames from eye text, only proposes', _src.count('os.rename(p, ' + 'q2)') == 0 and ('service proposes:' in _src))")
+    done.append('s441-trio')
+ls = next((k for k, l in enumerate(B) if l.strip().startswith('_lines = [re.split') and 'NAME-JOIN' in l), None)
+le = next((k for k, l in enumerate(B) if l.strip().startswith('if not fl and _lines: fl = _lines[0]')), None)
+if ls is not None and le is not None and le > ls:
+    d = P.ind(B[ls])
+    B[ls:le+1] = [d*' ' + "fl = _name_from_head_lines(t.split('\\n'))  # NAME-SCAN v85.95  # NAME-JOIN v85.98 (delegated v85.102): one naming law in one place - the eye asks the fixture-tested brain and keeps only its answer"]
+    done.append('eyename-delegates')
+k = next((i for i, l in enumerate(B) if l.strip().startswith("ck('S447 ")), None)
+if k is not None:
+    d = P.ind(B[k]); B[k] = d*' ' + "ck('S447 one naming law lives in one pure function, and the eye delegates to it', _src.count('def _name_from_head_lines(') == 1 and _src.count('_name_from_head_lines(' + 't.split') >= 1)"; done.append('s447-devacuated')
+lost = P.preflight(B, M0)
+if lost:
+    print('⛔ preflight markers would be lost:', sorted(lost)); raise SystemExit('fix before write')
+P.write(B); P.witness(M0)
+AR = os.path.join(os.getcwd(), 'ARCHITECTURE.md')
+t = open(AR).read()
+if 'v85.102' not in t:
+    open(AR, 'a').write('v85.102: the eye delegates to the fixture-tested brain so one naming law lives in one place; S441 trio pins propose-only structurally; S447 and S448 spell probes by concatenation so no guard can ever certify its own text (S448)\n')
+    done.append('arch-line')
+src = '\n'.join(B)
+def anch(*nd):
+    for x in nd:
+        hit = [k for k, l in enumerate(B) if x in l]
+        if hit: return hit[-1]
+    return None
+GU = [("'S448 a guard never certifies its own text", "'S447 one naming law lives in one pure function, and the eye delegates to it", "ck('S448 a guard never certifies its own text', _src.count('_name_from_head_lines(' + 't.split') >= 1 and (chr(35)+' delegated v85.102') in _src)")]
+for needle, fb, line in GU:
+    if needle not in src:
+        i = anch(needle, fb, "'S215 a lock must prove its holder lives before it names the world")
+        if i is None: raise SystemExit('anchor missing for ' + needle)
+        d = P.ind(B[i]); B.insert(i+1, d*' ' + line); done.append(needle.split()[0].strip("'") + '-guard')
+P.write(B)
+print('✅', done)
+PYEOF
